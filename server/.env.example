# ShED Forum Backend Server Configuration Example
NODE_ENV=development
PORT=5000

# Client Notification Email
NOTIFICATION_EMAIL=your-email@gmail.com

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password

# MongoDB Atlas Cloud Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rfwoyk7.mongodb.net/shed_forum?retryWrites=true&w=majority

# Cloudinary Cloud Image Hosting Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
